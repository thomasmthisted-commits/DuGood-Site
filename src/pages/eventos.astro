---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Heroi from '../components/Heroi.astro';
import Print from '../components/Print.astro';
import GaleriaAbas from '../components/GaleriaAbas.astro';
import Cartoes from '../components/Cartoes.astro';
import Perguntas from '../components/Perguntas.astro';
import Contato from '../components/Contato.astro';
import * as c from '../conteudo/eventos';
import ingresso from '../assets/mascotes/ingresso.png';
import celular from '../assets/mascotes/celular.png';
import trofeu from '../assets/mascotes/trofeu.png';
---

<Base pagina={c.pagina}>
  <Heroi {...c.heroi}>
    <a class="botao" href="#contato">Quero organizar um evento</a>
    <a class="botao botao--claro" href="#como-funciona">Ver como funciona</a>
    <Fragment slot="visual">
      <Print nome="evento" alt="Página de um evento beneficente no app DuGood, com informações e botão de inscrição" revelar={false} prioridade />
      <Image class="mascote heroi__mascote" src={ingresso} alt="" width={220} loading="eager" />
    </Fragment>
  </Heroi>

  <section class="secao secao--nevoa" id="como-funciona">
    <div class="conteiner">
      <div class="cabeca-secao" data-r>
        <span class="rotulo">{c.passos.rotulo}</span>
        <h2>{c.passos.titulo}</h2>
        <p class="lead">{c.passos.lead}</p>
      </div>
      <ol class="passos" data-r>
        {
          c.passos.itens.map((p) => (
            <li>
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="secao">
    <div class="conteiner duo">
      <Cartoes itens={c.recursos} duas />
      <div class="historia" data-r>
        <Image class="mascote" src={trofeu} alt="" width={200} />
        <span class="rotulo">{c.historia.rotulo}</span>
        <h2>{c.historia.titulo}</h2>
        <p class="lead">{c.historia.lead}</p>
      </div>
    </div>
  </section>

  <section class="secao secao--nevoa" id="painel">
    <div class="conteiner">
      <div class="cabeca-secao" data-r>
        <span class="rotulo">{c.painel.rotulo}</span>
        <h2>{c.painel.titulo}</h2>
      </div>
      <GaleriaAbas id="organizador" painel="Painel do organizador" abas={c.painel.abas} />
    </div>
  </section>

  <section class="secao">
    <div class="conteiner">
      <Cartoes itens={c.outros} />
    </div>
  </section>

  <Perguntas titulo="Dúvidas sobre eventos sociais." perguntas={c.pagina.perguntas} nevoa />

  <Contato publico="organizador" {...c.contato} mascote={celular} />
</Base>

<style>
  .historia .mascote {
    width: 150px;
    height: auto;
    margin-bottom: 20px;
  }
</style>
