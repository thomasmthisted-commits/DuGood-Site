---
import { render } from 'astro:content';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import Onda from '../../components/Onda.astro';
import Perguntas from '../../components/Perguntas.astro';
import LeiaTambem from '../../components/LeiaTambem.astro';
import Chamada from '../../components/Chamada.astro';
import { categoriasBlog, niveisBlog, type Publico } from '../../config';
import { Image } from 'astro:assets';
import { dataLonga, leitura, mascoteDo, posts, relacionados, type Post } from '../../lib/blog';
import { paginaPost } from '../../conteudo/blog';
import abraco from '../../assets/mascotes/abraco.png';
import acenando from '../../assets/mascotes/acenando.png';
import celular from '../../assets/mascotes/celular.png';

export async function getStaticPaths() {
  return (await posts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content, headings } = await render(post);
const d = post.data;
const secoes = headings.filter((h) => h.depth === 2);
const outros = await relacionados(post);
const url = new URL(`/blog/${post.id}`, Astro.site).href;
const minutos = leitura(post);

// Chamada final: leva ao formulário de quem o artigo ajuda, com o interesse já marcado
const destino: Record<Publico, { rota: string; texto: string; mascote: ImageMetadata }> = {
  empresa: { rota: '/empresas', texto: 'Falar com a DuGood', mascote: abraco },
  ong: { rota: '/ongs', texto: 'Quero levar minha ONG', mascote: acenando },
  organizador: { rota: '/eventos', texto: 'Quero organizar um evento', mascote: celular },
};
const cta = destino[d.publico];
const hrefContato = `${cta.rota}${d.interesse ? `?interesse=${d.interesse}` : ''}#contato`;

const artigo = {
  '@type': 'BlogPosting',
  '@id': `${url}#artigo`,
  headline: d.titulo,
  description: d.descricao,
  abstract: d.resumo,
  url,
  mainEntityOfPage: { '@id': `${url}#pagina` },
  isPartOf: { '@id': new URL('/blog#blog', Astro.site).href },
  inLanguage: 'pt-BR',
  datePublished: d.publicado.toISOString(),
  dateModified: (d.atualizado ?? d.publicado).toISOString(),
  author: { '@id': new URL('/#organizacao', Astro.site).href },
  publisher: { '@id': new URL('/#organizacao', Astro.site).href },
  articleSection: categoriasBlog[d.categoria].nome,
  educationalLevel: niveisBlog[d.nivel].nome,
  timeRequired: `PT${minutos}M`,
  wordCount: (post.body ?? '').split(/\s+/).filter(Boolean).length,
  citation: d.fontes.map((f) => ({ '@type': 'CreativeWork', name: f.titulo, url: f.url })),
};
---

<Base pagina={paginaPost(post)} dados={[artigo]} publicado={d.publicado} atualizado={d.atualizado ?? d.publicado}>
  <header class="heroi onda artigo__topo">
    <Onda prioridade />
    <div class="conteiner artigo__topo-conteudo">
      <nav class="migalhas" aria-label="Você está em">
        <a href="/blog">Blog</a>
        <span aria-hidden="true">/</span>
        <a href={`/blog/categoria/${d.categoria}`}>{categoriasBlog[d.categoria].nome}</a>
      </nav>
      <h1>{d.titulo}</h1>
      <p class="artigo__meta">
        <span class:list={['nivel', `nivel--${d.nivel}`]}>{niveisBlog[d.nivel].nome}</span>
        <span>{minutos} min de leitura</span>
        <span>
          {d.atualizado ? 'Atualizado em ' : 'Publicado em '}
          <time datetime={(d.atualizado ?? d.publicado).toISOString()}>{dataLonga(d.atualizado ?? d.publicado)}</time>
        </span>
      </p>
    </div>
    <Image class="mascote artigo__mascote" src={mascoteDo(post)} alt="" width={220} densities={[1, 2]} loading="eager" />
  </header>

  <div class="secao artigo">
    <div class="conteiner artigo__grade">
      <div class="resumo">
        <p class="resumo__titulo">Em resumo</p>
        <p>{d.resumo}</p>
      </div>
      <aside class="artigo__lado">
        {
          secoes.length > 2 && (
            <nav class="indice" aria-label="Neste artigo">
              <p class="indice__titulo">Neste artigo</p>
              <ol>
                {secoes.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        <div class="lado__contato">
          <p>Quer colocar isso em prática?</p>
          <a class="botao" href={hrefContato} data-interesse={d.interesse}>{cta.texto}</a>
        </div>
      </aside>

      <article class="artigo__texto">
        <div class="prosa">
          <Content />
        </div>
        <section class="fontes" aria-labelledby="fontes-titulo">
          <h2 id="fontes-titulo">Fontes</h2>
          <ul>
            {
              d.fontes.map((f) => (
                <li>
                  <a href={f.url} target="_blank" rel="noopener">{f.titulo}</a>
                </li>
              ))
            }
          </ul>
          <p class="fontes__aviso">
            Conteúdo informativo, com base na legislação e nas fontes acima na data indicada. Não substitui a orientação da
            contabilidade ou da assessoria jurídica para o seu caso.
          </p>
        </section>
      </article>
    </div>
  </div>

  {d.perguntas.length > 0 && <Perguntas titulo="Perguntas frequentes." perguntas={d.perguntas} nevoa />}

  <LeiaTambem titulo="Continue lendo." posts={outros} mais={{ texto: 'Ver todos os artigos', href: '/blog' }} nevoa={d.perguntas.length === 0} />

  <Chamada
    titulo="Vamos colocar isso em prática?"
    texto="A equipe da DuGood ajuda a transformar o assunto deste artigo em ação para a sua empresa, ONG ou evento."
    botoes={[
      { texto: cta.texto, href: hrefContato },
      { texto: 'Ver todos os artigos', href: '/blog' },
    ]}
    mascote={cta.mascote}
  />
</Base>

<style>
  .artigo__topo {
    padding-bottom: clamp(48px, 6vw, 80px);
  }
  .artigo__topo {
    position: relative;
  }
  .artigo__topo-conteudo {
    max-width: 900px;
  }
  .artigo__mascote {
    position: absolute;
    right: max(var(--gutter), calc((100% - var(--largura)) / 2 + var(--gutter)));
    bottom: 24px;
    width: auto;
    height: clamp(120px, 16vw, 200px);
    max-width: 240px;
    object-fit: contain;
    z-index: 1;
  }
  @media (min-width: 1000px) {
    .artigo__topo-conteudo {
      padding-right: 260px;
    }
  }
  @media (max-width: 999px) {
    .artigo__mascote {
      position: static;
      display: block;
      margin: 8px auto 0;
      height: 130px;
    }
  }
  .artigo__topo h1 {
    font-size: clamp(2rem, 4.4vw, 3rem);
    margin: 16px 0 20px;
  }
  .migalhas {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.9rem;
  }
  .migalhas a {
    color: rgb(255 255 255 / 0.9);
    text-decoration: none;
  }
  .migalhas a:hover {
    text-decoration: underline;
  }
  .migalhas span {
    color: rgb(255 255 255 / 0.5);
  }
  .artigo__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 18px;
    margin: 0;
    font-size: 0.92rem;
  }
  .artigo__grade {
    display: grid;
    gap: 32px;
    grid-template-areas: 'resumo' 'lado' 'texto';
  }
  .resumo {
    grid-area: resumo;
  }
  .artigo__lado {
    grid-area: lado;
  }
  .artigo__texto {
    grid-area: texto;
  }
  /* No celular, a chamada fica só no fim do artigo */
  .lado__contato {
    display: none;
  }
  @media (min-width: 1000px) {
    .artigo__grade {
      grid-template-columns: 260px minmax(0, 760px);
      grid-template-areas: 'lado resumo' 'lado texto';
      column-gap: 64px;
      row-gap: 0;
      align-items: start;
    }
    .artigo__lado {
      position: sticky;
      top: 104px;
    }
    .lado__contato {
      display: block;
    }
  }
  .artigo__texto {
    max-width: 760px;
    min-width: 0;
  }
  .resumo {
    background: var(--verde-claro);
    border-radius: var(--raio);
    padding: 22px 26px;
    color: var(--verde-escuro);
  }
  .resumo p {
    margin: 0;
  }
  .resumo .resumo__titulo {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  @media (min-width: 1000px) {
    .resumo {
      margin-bottom: 36px;
    }
  }
  .indice {
    border: 1px solid var(--linha);
    border-radius: var(--raio-p);
    padding: 20px;
    margin-bottom: 20px;
  }
  .indice__titulo {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tinta-fraca);
    margin-bottom: 12px;
  }
  .indice ol {
    margin: 0;
    padding-left: 1.2em;
    display: grid;
    gap: 8px;
    font-size: 0.92rem;
  }
  .indice a {
    color: var(--tinta-suave);
    text-decoration: none;
  }
  .indice a:hover {
    color: var(--verde-escuro);
  }
  .lado__contato {
    background: var(--nevoa);
    border-radius: var(--raio-p);
    padding: 20px;
  }
  .lado__contato p {
    font-weight: 600;
    color: var(--verde-escuro);
    margin-bottom: 12px;
  }
  .lado__contato .botao {
    width: 100%;
  }
  .fontes {
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--linha);
  }
  .fontes h2 {
    font-size: 1.2rem;
  }
  .fontes ul {
    padding-left: 1.2em;
    display: grid;
    gap: 6px;
    font-size: 0.94rem;
  }
  .fontes a {
    color: var(--verde-escuro);
  }
  .fontes__aviso {
    margin-top: 20px;
    font-size: 0.85rem;
    color: var(--tinta-fraca);
  }
</style>
