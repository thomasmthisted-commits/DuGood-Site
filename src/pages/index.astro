---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Heroi from '../components/Heroi.astro';
import Print from '../components/Print.astro';
import Lista from '../components/Lista.astro';
import Perguntas from '../components/Perguntas.astro';
import LeiaTambem from '../components/LeiaTambem.astro';
import { posts } from '../lib/blog';
import Chamada from '../components/Chamada.astro';
import Proposito from '../components/Proposito.astro';
import { appLink } from '../config';
import * as c from '../conteudo/inicio';
import acenando from '../assets/mascotes/acenando.png';
import presente from '../assets/mascotes/presente.png';
import lupa from '../assets/mascotes/lupa.png';
import ingresso from '../assets/mascotes/ingresso.png';
import abraco from '../assets/mascotes/abraco.png';

const mascotes = [presente, lupa, ingresso];

const destaques = (await posts()).filter((p) => p.data.destaque).slice(0, 3);
---

<Base pagina={c.pagina}>
  <Heroi {...c.heroi}>
    <a class="botao" href="#contato">Fale com a gente</a>
    <a class="botao botao--claro" href={appLink()} target="_blank" rel="noopener">Visitar o app</a>
    <Fragment slot="visual">
      <Print nome="inicio" alt="Tela inicial do app DuGood, com o total doado na plataforma e as causas populares" revelar={false} prioridade />
      <Image class="mascote heroi__mascote" src={acenando} alt="" width={220} loading="eager" />
    </Fragment>
  </Heroi>

  <section class="secao" id="para-quem">
    <div class="conteiner">
      <div class="cabeca-secao cabeca-secao--centro" data-r>
        <span class="rotulo">Para quem</span>
        <h2>Um lugar para cada parte da rede.</h2>
      </div>
      <div class="publicos" data-r>
        {
          c.publicos.map((p, i) => (
            <a class="publico" href={p.pagina.rota}>
              <Image class="mascote" src={mascotes[i]} alt="" width={160} />
              <span class="rotulo">{p.rotulo}</span>
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
              <span class="publico__mais">Conhecer →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="secao secao--nevoa">
    <div class="conteiner duo duo--inverso">
      <div data-r>
        <span class="rotulo">{c.rede.rotulo}</span>
        <h2>{c.rede.titulo}</h2>
        <Lista itens={c.rede.itens} />
      </div>
      <div class="par-prints">
        <Print nome="explorar-ongs" alt="Tela Explorar do app, com a lista de ONGs" legenda="ONGs no app" />
        <Print nome="beneficios-lista" alt="Tela de benefícios do app, com descontos de marcas parceiras" legenda="Benefícios de marcas" />
      </div>
    </div>
  </section>

  <section class="secao" id="quem-somos">
    <div class="conteiner">
      <div class="cabeca-secao" data-r>
        <span class="rotulo">{c.proposito.rotulo}</span>
        <h2>{c.proposito.titulo}</h2>
        <p class="lead">A DuGood nasceu numa competição beneficente de natação da Poli-USP. <a href="/sobre">Conheça a nossa história e os fundadores →</a></p>
      </div>
      <Proposito />
    </div>
  </section>

  <LeiaTambem titulo="Do blog da DuGood." posts={destaques} mais={{ texto: 'Ver todos os artigos', href: '/blog' }} nevoa />

  <Perguntas titulo="Perguntas sobre a DuGood." perguntas={c.pagina.perguntas} />

  <Chamada
    titulo={c.contato.titulo}
    texto={c.contato.lead}
    botoes={c.publicos.map((p) => ({ texto: p.botao, href: `${p.pagina.rota}#contato` }))}
    mascote={abraco}
  />
</Base>

<style>
  .publicos {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  }
  .publico {
    display: flex;
    flex-direction: column;
    background: var(--nevoa);
    border-radius: var(--raio);
    padding: 32px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s var(--curva), background 0.25s;
  }
  .publico:hover {
    transform: translateY(-4px);
    background: var(--verde-claro);
  }
  .publico .mascote {
    width: 112px;
    height: 112px;
    object-fit: contain;
    margin-bottom: 20px;
  }
  .publico p {
    color: var(--tinta-suave);
    flex: 1;
  }
  .publico__mais {
    font-weight: 600;
    color: var(--verde-escuro);
  }
</style>
