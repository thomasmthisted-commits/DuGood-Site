---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Heroi from '../components/Heroi.astro';
import Print from '../components/Print.astro';
import GaleriaAbas from '../components/GaleriaAbas.astro';
import Simulador from '../components/Simulador.astro';
import Lista from '../components/Lista.astro';
import Cartoes from '../components/Cartoes.astro';
import Perguntas from '../components/Perguntas.astro';
import LeiaTambem from '../components/LeiaTambem.astro';
import { postsDaCategoria } from '../lib/blog';
import Contato from '../components/Contato.astro';
import Onda from '../components/Onda.astro';
import Diagnostico from '../components/Diagnostico.astro';
import { textos as diag } from '../conteudo/diagnostico';
import trofeu from '../assets/mascotes/trofeu.png';
import { niveis, termosLink } from '../config';
import * as c from '../conteudo/empresas';
import presente from '../assets/mascotes/presente.png';
import joinha from '../assets/mascotes/joinha.png';
import abraco from '../assets/mascotes/abraco.png';

const artigos = (await postsDaCategoria('incentivo-fiscal')).slice(0, 3);
---

<Base pagina={c.pagina}>
  <Heroi {...c.heroi}>
    <a class="botao" href="#apoiador">Ser apoiador</a>
    <a class="botao botao--claro" href="#incentivada">Doação incentivada</a>
    <Fragment slot="visual">
      <Print nome="beneficios-lista" alt="Tela de benefícios do app DuGood, com descontos de lojas parceiras por nível" revelar={false} prioridade />
      <Image class="mascote heroi__mascote" src={presente} alt="" width={220} loading="eager" />
    </Fragment>
  </Heroi>

  <section class="secao" id="caminhos" aria-labelledby="caminhos-titulo">
    <div class="conteiner">
      <div class="cabeca-secao cabeca-secao--centro" data-r>
        <span class="rotulo">{c.caminhos.rotulo}</span>
        <h2 id="caminhos-titulo">{c.caminhos.titulo}</h2>
        <p class="lead">{c.caminhos.lead}</p>
      </div>
      <div class="caminhos" data-r>
        {
          c.caminhos.itens.map((k) => (
            <div class="caminho">
              <span class="rotulo">{k.rotulo}</span>
              <h3>{k.titulo}</h3>
              <p>{k.texto}</p>
              <ul class="lista-check">
                {k.pontos.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
              <div class="botoes">
                <a class="botao" href={`#${k.id}`}>Saiba mais</a>
                <a class="botao botao--claro" href="#contato" data-interesse={k.interesse}>{k.botao}</a>
              </div>
            </div>
          ))
        }
      </div>
      <div class="custo onda onda--cartao" data-r>
        <Onda sizes="(min-width: 1200px) 1100px, 100vw" />
        <strong>{c.caminhos.custo.titulo}</strong>
        <span>{c.caminhos.custo.texto}</span>
      </div>
    </div>
  </section>

  <section class="secao secao--nevoa" id="apoiador" aria-labelledby="apoiador-titulo">
    <div class="conteiner duo duo--inverso">
      <div data-r>
        <span class="rotulo">{c.apoiador.rotulo}</span>
        <h2 id="apoiador-titulo">{c.apoiador.titulo}</h2>
        <p class="lead">{c.apoiador.lead}</p>
        <ol class="ciclo">
          {
            c.apoiador.ciclo.map((e) => (
              <li>
                <strong>{e.titulo}</strong>
                <span>{e.texto}</span>
              </li>
            ))
          }
        </ol>
        <ul class="niveis">
          {niveis.map((n) => <li><strong>{n.nome}</strong><span>{n.pontos}</span></li>)}
        </ul>
      </div>
      <div class="par-prints">
        <Print nome="beneficio-detalhe" alt="Detalhe de um benefício no app: desconto, categoria e nível exigido" legenda="O benefício dentro do app" />
        <Print nome="niveis" alt="Níveis de doação no app: Bronze, Prata, Ouro e Platina" legenda="Os níveis de quem doa" />
      </div>
    </div>
  </section>

  <section class="secao" id="ganhos">
    <div class="conteiner">
      <div class="cabeca-secao" data-r>
        <span class="rotulo">{c.ganhos.rotulo}</span>
        <h2>{c.ganhos.titulo}</h2>
      </div>
      <Cartoes itens={c.ganhos.itens} />
      <div class="exemplos">
        <div class="cabeca-secao" data-r>
          <span class="rotulo">{c.exemplos.rotulo}</span>
          <h3 class="subtitulo">{c.exemplos.titulo}</h3>
          <p class="lead">{c.exemplos.lead}</p>
        </div>
        <Cartoes itens={c.exemplos.itens} />
      </div>
      <div class="chamada-linha" data-r>
        <a class="botao" href="#contato" data-interesse="beneficios">{c.apoiador.chamada}</a>
      </div>
    </div>
  </section>

  <section class="secao secao--nevoa" id="painel">
    <div class="conteiner">
      <div class="cabeca-secao" data-r>
        <span class="rotulo">{c.painel.rotulo}</span>
        <h2>{c.painel.titulo}</h2>
        <p class="lead">{c.painel.lead}</p>
      </div>
      <GaleriaAbas id="lojista" painel="Painel do lojista" abas={c.painel.abas} />
    </div>
  </section>

  <section class="secao" id="incentivada" aria-labelledby="incentivada-titulo">
    <div class="conteiner duo">
      <div data-r>
        <span class="rotulo">{c.incentivada.rotulo}</span>
        <h2 id="incentivada-titulo">{c.incentivada.titulo}</h2>
        <p class="lead">{c.incentivada.lead}</p>
        <Lista itens={c.incentivada.itens} />
      </div>
      <div data-r>
        <Simulador />
      </div>
    </div>
  </section>

  <section class="secao secao--nevoa" id="marca" aria-labelledby="marca-titulo">
    <div class="conteiner">
      <div class="cabeca-secao" data-r>
        <span class="rotulo">{c.marca.rotulo}</span>
        <h2 id="marca-titulo">{c.marca.titulo}</h2>
        <p class="lead">{c.marca.lead}</p>
      </div>
      <Cartoes itens={c.marca.itens} />
      <div class="exemplo onda onda--cartao" data-r>
        <Onda sizes="(min-width: 1200px) 1100px, 100vw" />
        <div class="exemplo__texto">
          <span class="rotulo">{c.marca.exemplo.rotulo}</span>
          <h3>{c.marca.exemplo.titulo}</h3>
          <p>{c.marca.exemplo.texto}</p>
          <p class="exemplo__nota">{c.marca.exemplo.nota}</p>
          <a class="botao" href="#contato" data-interesse="incentivada">{c.marca.botao}</a>
        </div>
        <Image class="mascote exemplo__mascote" src={trofeu} alt="" width={200} densities={[1, 2]} />
      </div>
    </div>
  </section>

  <section class="secao" id="consultivo">
    <div class="conteiner">
      <div class="cabeca-secao" data-r>
        <span class="rotulo">{c.consultivo.rotulo}</span>
        <h2>{c.consultivo.titulo}</h2>
        <p class="lead">{c.consultivo.lead}</p>
      </div>
      <Cartoes itens={c.pilares} />
      <div class="passo-a-passo">
        <div class="cabeca-secao" data-r>
          <span class="rotulo">{c.passos.rotulo}</span>
          <h3 class="subtitulo">{c.passos.titulo}</h3>
        </div>
        <ol class="passos" data-r>
          {
            c.passos.itens.map((p) => (
              <li>
                <h3>{p.titulo}</h3>
                <p>{p.texto}</p>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="chamada-linha botoes" data-r>
        <a class="botao" href="#contato" data-interesse="incentivada">{c.consultivo.botao}</a>
        <a class="botao botao--claro" href="#diagnostico">Fazer o diagnóstico rápido</a>
      </div>
    </div>
  </section>

  <section class="secao secao--nevoa" id="diagnostico" aria-labelledby="diagnostico-titulo">
    <div class="conteiner">
      <div class="cabeca-secao" data-r>
        <span class="rotulo">{diag.rotulo}</span>
        <h2 id="diagnostico-titulo">{diag.titulo}</h2>
        <p class="lead">{diag.lead}</p>
      </div>
      <Diagnostico />
    </div>
  </section>

  <section class="secao">
    <div class="conteiner">
      <div class="cabeca-secao" data-r>
        <span class="rotulo">{c.outras.rotulo}</span>
        <h2>{c.outras.titulo}</h2>
      </div>
      <Cartoes itens={c.outras.itens} />
    </div>
  </section>

  <section class="secao secao--nevoa" id="politica">
    <div class="conteiner duo">
      <div data-r>
        <span class="rotulo">{c.secaoPolitica.rotulo}</span>
        <h2>{c.secaoPolitica.titulo}</h2>
        <p class="lead">É um dos valores da DuGood, e está nos <a href={termosLink} target="_blank" rel="noopener">Termos de Uso</a>.</p>
        <Image class="mascote politica__mascote" src={joinha} alt="" width={200} />
      </div>
      <Lista itens={c.secaoPolitica.itens} class="politica" />
    </div>
  </section>

  <LeiaTambem titulo="Leis de incentivo, do básico ao guia completo." posts={artigos} mais={{ texto: 'Ver o tema completo', href: '/blog/categoria/incentivo-fiscal' }} />

  <Perguntas titulo="Dúvidas de quem está começando." perguntas={c.pagina.perguntas} nevoa />

  <Contato publico="empresa" {...c.contato} mascote={abraco} />
</Base>

<style>
  .caminhos {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
  }
  .caminho {
    background: var(--nevoa);
    border-radius: var(--raio);
    padding: clamp(28px, 4vw, 40px);
    display: flex;
    flex-direction: column;
  }
  .caminho h3 {
    font-size: 1.5rem;
  }
  .caminho > p {
    color: var(--tinta-suave);
  }
  .caminho .lista-check {
    flex: 1;
  }
  .custo {
    margin-top: 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    align-items: baseline;
    padding: 22px 28px;
  }
  .custo strong {
    font-family: var(--titulo);
    font-size: 1.2rem;
  }
  .exemplos,
  .passo-a-passo {
    margin-top: clamp(48px, 6vw, 72px);
  }
  .subtitulo {
    font-size: clamp(1.4rem, 2.6vw, 1.8rem);
    margin: 0;
  }
  .exemplo {
    margin-top: 24px;
    padding: clamp(28px, 4vw, 48px);
    display: grid;
    gap: 24px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .exemplo {
      grid-template-columns: 1fr auto;
    }
  }
  .exemplo h3 {
    font-size: clamp(1.4rem, 2.6vw, 1.8rem);
    margin: 4px 0 12px;
  }
  .exemplo__texto p {
    max-width: 62ch;
  }
  .exemplo .exemplo__nota {
    font-size: 0.85rem;
    opacity: 0.8;
  }
  .exemplo__mascote {
    width: 170px;
    height: auto;
    justify-self: center;
  }
  .chamada-linha.botoes {
    justify-content: center;
  }
  .chamada-linha {
    margin-top: 40px;
    text-align: center;
  }
  .ciclo {
    list-style: none;
    padding: 0;
    margin: 0 0 20px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .ciclo li {
    position: relative;
    display: grid;
    gap: 4px;
    align-content: start;
    background: var(--verde-claro);
    border-radius: var(--raio-p);
    padding: 14px 16px;
    color: var(--verde-escuro);
  }
  .ciclo li:not(:last-child)::after {
    content: '→';
    position: absolute;
    z-index: 1;
    right: -16px;
    top: 13px;
    width: 14px;
    text-align: center;
    color: var(--verde);
    font-weight: 700;
  }
  .ciclo strong {
    font-family: var(--titulo);
  }
  .ciclo span {
    font-size: 0.85rem;
    opacity: 0.85;
  }
  @media (max-width: 560px) {
    .ciclo {
      grid-template-columns: 1fr;
    }
    .ciclo li:not(:last-child)::after {
      content: '↓';
      right: auto;
      left: 16px;
      top: auto;
      bottom: -18px;
    }
  }
  .niveis {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  .niveis li {
    background: #fff;
    border-radius: var(--raio-p);
    padding: 12px 16px;
    display: grid;
    box-shadow: var(--sombra);
  }
  .niveis strong {
    font-family: var(--titulo);
    color: var(--verde-escuro);
  }
  .niveis span {
    font-size: 0.85rem;
    color: var(--tinta-fraca);
  }
  .politica__mascote {
    width: 160px;
    height: auto;
    margin-top: 12px;
  }
  :global(.politica) li {
    background: #fff;
    border-radius: var(--raio-p);
    padding: 18px 20px 18px 54px;
    box-shadow: var(--sombra);
  }
  :global(.politica) li::before {
    left: 20px;
    top: 21px;
  }
</style>
