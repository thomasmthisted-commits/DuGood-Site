---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Heroi from '../components/Heroi.astro';
import Print from '../components/Print.astro';
import GaleriaAbas from '../components/GaleriaAbas.astro';
import Lista from '../components/Lista.astro';
import Cartoes from '../components/Cartoes.astro';
import Perguntas from '../components/Perguntas.astro';
import LeiaTambem from '../components/LeiaTambem.astro';
import { postsDaCategoria } from '../lib/blog';
import Contato from '../components/Contato.astro';
import Onda from '../components/Onda.astro';
import { appLink, termosLink, widget as widgetConfig, widgetCodigo } from '../config';
import * as c from '../conteudo/ongs';
import lupa from '../assets/mascotes/lupa.png';
import trofeu from '../assets/mascotes/trofeu.png';
import coracao from '../assets/mascotes/coracao.png';
import acenando from '../assets/mascotes/acenando.png';

const artigos = (await postsDaCategoria('para-ongs')).slice(0, 3);
---

<Base pagina={c.pagina}>
  <Heroi {...c.heroi}>
    <a class="botao" href="#contato" data-interesse="captar">Quero levar minha ONG</a>
    <a class="botao botao--claro" href="#taxa-zero">Como é a taxa zero</a>
    <Fragment slot="visual">
      <Print nome="ong-perfil" alt="Página de uma ONG no app DuGood, com total arrecadado, doadores, causas e eventos" revelar={false} prioridade />
      <Image class="mascote heroi__mascote" src={lupa} alt="" width={220} loading="eager" />
    </Fragment>
  </Heroi>

  <section class="secao" id="taxa-zero" aria-labelledby="taxa-titulo">
    <div class="conteiner">
      <div class="cabeca-secao cabeca-secao--centro" data-r>
        <span class="selo-taxa">Taxa zero</span>
        <h2 id="taxa-titulo">{c.taxaZero.titulo}</h2>
        <p class="lead">{c.taxaZero.lead}</p>
      </div>
      <Cartoes itens={c.taxaZero.itens} />
      <p class="taxa__nota" data-r>{c.taxaZero.nota}</p>
    </div>
  </section>

  <section class="secao secao--nevoa" id="no-app">
    <div class="conteiner">
      <div class="cabeca-secao cabeca-secao--centro" data-r>
        <span class="rotulo">{c.noApp.rotulo}</span>
        <h2>{c.noApp.titulo}</h2>
        <p class="lead">{c.noApp.lead}</p>
      </div>
      <div class="trio">
        <Print nome="ong-perfil" alt="Página da ONG no app" legenda="A página da ONG" />
        <Print nome="causa" alt="Página de uma causa com meta, valor arrecadado e botão Doar" legenda="Uma causa com meta" />
        <Print nome="evento" alt="Página de um evento beneficente com inscrição" legenda="Um evento com inscrição" />
      </div>

      <div class="duo widget" id="widget">
        <div data-r>
          <span class="rotulo">{c.widget.rotulo}</span>
          <h2>{c.widget.titulo}</h2>
          <p class="lead">{c.widget.lead}</p>
          <Lista itens={c.widget.itens} />
          <pre class="widget__codigo"><code>{widgetCodigo('ID_DA_SUA_ONG')}</code></pre>
        </div>
        <div class="widget__exemplo">
          <div data-dugood-ong={widgetConfig.ongExemplo}></div>
          <p class="widget__reserva" hidden>
            <a href={appLink(`OrganizationProfile?id=${widgetConfig.ongExemplo}`)} target="_blank" rel="noopener">Ver a página de exemplo na DuGood</a>
          </p>
          <p class="widget__nota">{c.widget.nota}</p>
        </div>
      </div>
    </div>
  </section>
  <script is:inline async src={widgetConfig.script}></script>
  <script is:inline>
    // Se o widget não carregar (app fora do ar ou bloqueado), fica o link para a página na DuGood
    window.addEventListener('load', function () {
      setTimeout(function () {
        if (window.DuGoodWidget) return;
        var r = document.querySelector('.widget__reserva');
        if (r) r.hidden = false;
      }, 3000);
    });
  </script>

  <section class="secao">
    <div class="conteiner duo">
      <div data-r>
        <span class="rotulo">{c.voltam.rotulo}</span>
        <h2>{c.voltam.titulo}</h2>
        <p class="lead">{c.voltam.lead}</p>
        <Image class="mascote duo__mascote" src={trofeu} alt="" width={220} />
      </div>
      <Cartoes itens={c.voltam.itens} duas />
    </div>
  </section>

  <section class="secao secao--nevoa" id="painel">
    <div class="conteiner">
      <div class="cabeca-secao" data-r>
        <span class="rotulo">{c.painel.rotulo}</span>
        <h2>{c.painel.titulo}</h2>
        <p class="lead">{c.painel.lead}</p>
      </div>
      <GaleriaAbas id="ong" painel="Painel da ONG" abas={c.painel.abas} />
    </div>
  </section>

  <section class="secao" id="financeiro">
    <div class="conteiner duo">
      <div data-r>
        <span class="rotulo">{c.financeiro.rotulo}</span>
        <h2>{c.financeiro.titulo}</h2>
        <p class="lead">{c.financeiro.lead}</p>
        <Lista itens={c.financeiro.itens} />
      </div>
      <div class="financeiro__prints">
        <Print nome="ong-painel-extrato" tipo="janela" alt="Extrato no painel da ONG: entradas, tarifas, valor líquido e repasses" legenda="O extrato no painel" />
        <Print nome="ong-relatorio-pdf" tipo="documento" alt="Relatório mensal de captação em PDF: total captado, doações, doadores e de onde veio o dinheiro" legenda="O relatório mensal em PDF" />
      </div>
    </div>
  </section>

  <section class="secao secao--nevoa" id="incentivados">
    <div class="conteiner duo duo--inverso">
      <div data-r>
        <span class="rotulo">{c.incentivados.rotulo}</span>
        <h2>{c.incentivados.titulo}</h2>
        <Lista itens={c.incentivados.itens} />
        <a class="botao botao--claro" href="#contato" data-interesse="incentivado">Tenho um projeto incentivado</a>
      </div>
      <div class="destaque onda onda--cartao" data-r>
        <Onda sizes="(min-width: 900px) 560px, 100vw" />
        <Image class="mascote destaque__mascote" src={coracao} alt="" width={120} />
        <h3>{c.incentivados.destaque.titulo}</h3>
        <p>{c.incentivados.destaque.texto}</p>
      </div>
    </div>
  </section>

  <section class="secao" id="como-entrar">
    <div class="conteiner">
      <div class="cabeca-secao" data-r>
        <span class="rotulo">{c.passos.rotulo}</span>
        <h2>{c.passos.titulo}</h2>
      </div>
      <ol class="passos" data-r>
        {
          c.passos.itens.map((p) => (
            <li>
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="secao secao--nevoa" id="politica">
    <div class="conteiner duo">
      <div data-r>
        <span class="rotulo">{c.secaoPolitica.rotulo}</span>
        <h2>{c.secaoPolitica.titulo}</h2>
        <p class="lead">Regras claras, nos <a href={termosLink} target="_blank" rel="noopener">Termos de Uso</a>.</p>
      </div>
      <Lista itens={c.secaoPolitica.itens} />
    </div>
  </section>

  <LeiaTambem titulo="Conteúdos para ONGs." posts={artigos} mais={{ texto: 'Ver o tema completo', href: '/blog/categoria/para-ongs' }} />

  <Perguntas titulo="O que as ONGs costumam perguntar." perguntas={c.pagina.perguntas} nevoa />

  <Contato publico="ong" {...c.contato} mascote={acenando} />
</Base>

<style>
  .selo-taxa {
    display: inline-block;
    font: 700 0.95rem var(--titulo);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
    background: var(--verde-escuro);
    border-radius: 999px;
    padding: 6px 16px;
    margin-bottom: 16px;
  }
  .taxa__nota {
    max-width: 760px;
    margin: 28px auto 0;
    text-align: center;
    font-size: 0.9rem;
    color: var(--tinta-fraca);
  }
  .trio {
    display: grid;
    gap: 40px;
    justify-items: center;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .trio :global(.print--celular) {
    width: 100%;
    max-width: 280px;
  }
  @media (min-width: 900px) {
    .trio :global(.print:nth-child(2)) {
      margin-top: 48px;
    }
  }
  .widget {
    margin-top: clamp(64px, 9vw, 112px);
    align-items: start;
  }
  .widget__codigo {
    margin-top: 24px;
    padding: 16px;
    background: #fff;
    border: 1px solid var(--linha);
    border-radius: 14px;
    font-size: 0.8rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: var(--tinta-fraca);
  }
  .widget__nota,
  .widget__reserva {
    margin-top: 12px;
    text-align: center;
    font-size: 0.85rem;
    color: var(--tinta-fraca);
  }
  .financeiro__prints {
    display: grid;
    gap: 32px;
  }
  @media (min-width: 900px) {
    .financeiro__prints :global(.print--documento) {
      width: 82%;
      margin-left: auto;
    }
  }
  .duo__mascote {
    width: 180px;
    height: auto;
    margin-top: 8px;
  }
  .destaque {
    padding: 40px 32px 32px;
  }
  .destaque h3 {
    font-size: 1.5rem;
    max-width: 18ch;
  }
  .destaque .destaque__mascote {
    width: 96px;
    margin: 0 0 16px;
  }
</style>
