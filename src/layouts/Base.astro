---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { dugood, rascunho, instagramLink } from '../config';
import ogPadrao from '../assets/og.png';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  titulo: string;
  descricao: string;
  imagem?: ImageMetadata;
  /** Dados estruturados extras (schema.org), além da Organization do site */
  dados?: object[];
  /** false: página fora dos buscadores */
  indexar?: boolean;
}

const { titulo, descricao, imagem, dados = [], indexar = true } = Astro.props;
const tituloCompleto = titulo.includes(dugood.nome) ? titulo : `${titulo} | ${dugood.nome}`;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '') || '/', Astro.site);
const og = await getImage({ src: imagem ?? ogPadrao, width: 1200, format: 'png' });

const organizacao = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: dugood.nome,
  description: dugood.descricao,
  url: Astro.site?.href,
  logo: new URL('/logo.png', Astro.site).href,
  email: dugood.email,
  sameAs: [dugood.app, instagramLink],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    {(rascunho || !indexar) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={dugood.nome} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(og.src, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700&display=swap"
    />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(organizacao)} />
    {dados.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/revelar';
    </script>
  </body>
</html>

<style>
  .pular {
    position: absolute;
    left: -999px;
    top: 8px;
    background: var(--verde-escuro);
    color: #fff;
    padding: 8px 16px;
    border-radius: 8px;
    z-index: 100;
  }
  .pular:focus {
    left: 8px;
  }
</style>
