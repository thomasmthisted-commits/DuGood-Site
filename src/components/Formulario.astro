---
// Formulário de contato. Envia para /api/contato (src/worker.js), que repassa ao Base44:
// o contato cai na lista "Contatos do site" do Admin da DuGood e os admins recebem um e-mail.
// Sem JS, o envio é um POST normal e o Worker redireciona para /obrigado.
//
// Preenchimento prévio:
// - CNPJ: ao digitar um CNPJ válido, /api/cnpj busca nome, cidade e regime na base pública;
// - interesse: botões com data-interesse="<id>" e o endereço ?interesse=<id> marcam a opção;
// - mensagem: o simulador manda o valor simulado (evento dugood:mensagem);
// - dados da pessoa: nome, e-mail, WhatsApp e organização ficam na aba do navegador
//   (sessionStorage) e já aparecem preenchidos nos formulários das outras páginas.
import { privacidadeLink, dugood, interesses, type Publico } from '../config';

interface Props {
  publico: Publico;
  titulo?: string;
}

const { publico, titulo = 'Fale com a gente' } = Astro.props;

const nomeOrganizacao: Record<Publico, string> = {
  empresa: 'Empresa',
  ong: 'Nome da ONG',
  organizador: 'Organização, coletivo ou time',
};

const categorias = ['Educação', 'Saúde', 'Esportes', 'Crianças', 'Animais', 'Ambiental', 'Alimentação', 'Moradia', 'Vestuário', 'Outra'];
---

<form class="form" method="post" action="/api/contato" data-form-contato>
  <input type="hidden" name="publico" value={publico} />
  <input type="hidden" name="pagina" value={Astro.url.pathname.replace(/\.html$/, '')} />
  <input type="hidden" name="utm" value="" data-utm />
  <input type="hidden" name="t" value="" data-t />
  <input type="hidden" name="razao_social" value="" data-campo-cnpj="razao_social" />
  <div class="form__isca" aria-hidden="true">
    <label>Não preencha <input type="text" name="site" tabindex="-1" autocomplete="off" /></label>
  </div>

  <h3>{titulo}</h3>

  <label class="form__cnpj">
    <span>CNPJ {publico === 'organizador' ? '(se houver)' : ''}</span>
    <input name="cnpj" inputmode="numeric" autocomplete="off" maxlength="18" placeholder="00.000.000/0000-00" data-cnpj />
    <small data-cnpj-status>{publico === 'organizador' ? 'Opcional.' : 'Comece por aqui: preenchemos o nome e a cidade para você.'}</small>
  </label>

  <div class="form__grade">
    <label>
      <span>{nomeOrganizacao[publico]} *</span>
      <input name="organizacao" required autocomplete="organization" maxlength="160" data-lembrar data-campo-cnpj="nome" />
    </label>
    <label>
      <span>Seu nome *</span>
      <input name="nome" required autocomplete="name" maxlength="120" data-lembrar />
    </label>
    <label>
      <span>E-mail *</span>
      <input name="email" type="email" required autocomplete="email" maxlength="160" data-lembrar />
    </label>
    <label>
      <span>WhatsApp *</span>
      <input name="telefone" type="tel" required autocomplete="tel" inputmode="tel" maxlength="30" placeholder="(11) 90000-0000" data-lembrar />
    </label>

    {
      publico === 'empresa' && (
        <>
          <label>
            <span>Cargo</span>
            <input name="cargo" autocomplete="organization-title" maxlength="80" data-lembrar />
          </label>
          <label>
            <span>Regime tributário</span>
            <select name="regime" data-campo-cnpj="regime">
              <option value="">Selecione</option>
              <option>Lucro real</option>
              <option>Lucro presumido</option>
              <option>Simples Nacional</option>
              <option>Não sei</option>
            </select>
          </label>
        </>
      )
    }

    {
      publico === 'ong' && (
        <>
          <label>
            <span>Área de atuação</span>
            <select name="area">
              <option value="">Selecione</option>
              {categorias.map((c) => (
                <option>{c}</option>
              ))}
            </select>
          </label>
          <label>
            <span>Cidade / UF</span>
            <input name="cidade" autocomplete="address-level2" maxlength="80" data-campo-cnpj="cidade" />
          </label>
        </>
      )
    }

    {
      publico === 'organizador' && (
        <>
          <label>
            <span>Data prevista</span>
            <input name="data_evento" maxlength="60" placeholder="ex.: março de 2027" />
          </label>
          <label>
            <span>ONG que vai receber (se já tiver)</span>
            <input name="ong_beneficiada" maxlength="160" />
          </label>
        </>
      )
    }
  </div>

  <fieldset>
    <legend>{publico === 'organizador' ? 'Tipo de evento' : 'Tenho interesse em'}</legend>
    <div class="form__opcoes">
      {
        interesses[publico].map((i) => (
          <label class="form__opcao">
            <input type="checkbox" name="interesses" value={i.texto} data-interesse-id={i.id} />
            <span>{i.texto}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <label class="form__largo">
    <span>Mensagem</span>
    <textarea name="mensagem" rows="4" maxlength="3000" placeholder="Conte um pouco sobre o que vocês têm em mente"></textarea>
  </label>

  <label class="form__aceite">
    <input type="checkbox" name="aceite" value="sim" required />
    <span>Autorizo a DuGood a usar estes dados para entrar em contato comigo, conforme a <a href={privacidadeLink} target="_blank" rel="noopener">Política de Privacidade</a>.</span>
  </label>

  <button class="botao" type="submit">Enviar</button>
  <p class="form__status" role="status" aria-live="polite" data-status></p>
  <p class="form__alt">Se preferir, escreva para <a href={`mailto:${dugood.email}`}>{dugood.email}</a>.</p>
</form>

<div class="form form__ok" hidden data-ok>
  <h3>Recebemos seu contato!</h3>
  <p>Obrigado pelo interesse. A equipe da DuGood vai responder em breve pelo e-mail ou WhatsApp que você informou.</p>
</div>

<script>
  import { cnpjValido, formatarCnpj } from '../scripts/cnpj';

  const ORIGEM = 'dugood-origem';
  const DADOS = 'dugood-contato';
  const ler = (chave: string) => {
    try {
      return sessionStorage.getItem(chave);
    } catch {
      return null;
    }
  };
  const gravar = (chave: string, valor: string) => {
    try {
      sessionStorage.setItem(chave, valor);
    } catch {}
  };

  // Origem da visita (UTM ou site de referência), guardada na primeira página vista
  try {
    const utm = [...new URLSearchParams(location.search)].filter(([k]) => k.startsWith('utm_')).map(([k, v]) => `${k}=${v}`).join('&');
    if (utm) gravar(ORIGEM, utm);
    else if (document.referrer && !document.referrer.startsWith(location.origin) && !ler(ORIGEM)) gravar(ORIGEM, `ref=${new URL(document.referrer).hostname}`);
  } catch {}

  const marcarInteresses = (form: HTMLFormElement, ids: string[]) => {
    for (const id of ids) {
      const caixa = form.querySelector<HTMLInputElement>(`[data-interesse-id="${CSS.escape(id)}"]`);
      if (caixa) caixa.checked = true;
    }
  };

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-form-contato]')) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const ok = form.nextElementSibling as HTMLElement;
    const mensagem = form.querySelector<HTMLTextAreaElement>('textarea[name=mensagem]')!;
    form.querySelector<HTMLInputElement>('[data-t]')!.value = String(Date.now());
    form.querySelector<HTMLInputElement>('[data-utm]')!.value = ler(ORIGEM) ?? '';

    // Dados que a pessoa já digitou em outra página do site
    const lembrados: Record<string, string> = JSON.parse(ler(DADOS) ?? '{}');
    for (const campo of form.querySelectorAll<HTMLInputElement>('[data-lembrar]')) {
      if (!campo.value && lembrados[campo.name]) campo.value = lembrados[campo.name];
      campo.addEventListener('change', () => {
        const atuais = JSON.parse(ler(DADOS) ?? '{}');
        gravar(DADOS, JSON.stringify({ ...atuais, [campo.name]: campo.value.trim() }));
      });
    }

    // Interesse vindo do endereço: /empresas?interesse=incentivada#contato
    marcarInteresses(form, (new URLSearchParams(location.search).get('interesse') ?? '').split(',').filter(Boolean));

    // CNPJ: busca nome, cidade e regime na base pública e preenche o que estiver vazio
    const cnpj = form.querySelector<HTMLInputElement>('[data-cnpj]')!;
    const cnpjStatus = form.querySelector<HTMLElement>('[data-cnpj-status]')!;
    const cnpjDica = cnpjStatus.textContent;
    let ultimoCnpj = '';
    cnpj.addEventListener('input', async () => {
      const digitos = cnpj.value.replace(/\D/g, '').slice(0, 14);
      cnpj.value = formatarCnpj(digitos);
      if (digitos.length < 14) {
        cnpjStatus.textContent = cnpjDica;
        cnpjStatus.removeAttribute('data-tom');
        return;
      }
      if (!cnpjValido(digitos)) {
        cnpjStatus.textContent = 'Confira o CNPJ: os dígitos não batem.';
        cnpjStatus.dataset.tom = 'erro';
        return;
      }
      if (digitos === ultimoCnpj) return;
      ultimoCnpj = digitos;
      cnpjStatus.textContent = 'Buscando os dados do CNPJ…';
      cnpjStatus.removeAttribute('data-tom');
      try {
        const r = await fetch(`/api/cnpj/${digitos}`, { headers: { accept: 'application/json' } });
        if (!r.ok) throw new Error(r.status === 404 ? 'CNPJ não encontrado na base pública. Pode seguir preenchendo.' : '');
        const dados: Record<string, string> = await r.json();
        for (const campo of form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-campo-cnpj]')) {
          const valor = dados[campo.dataset.campoCnpj!];
          if (valor && (!campo.value || campo.type === 'hidden')) {
            campo.value = valor;
            campo.dispatchEvent(new Event('change'));
          }
        }
        cnpjStatus.textContent = `✓ ${dados.razao_social}${dados.cidade ? ` · ${dados.cidade}` : ''}${dados.situacao && dados.situacao !== 'Ativa' ? ` · situação: ${dados.situacao}` : ''}`;
        cnpjStatus.dataset.tom = 'ok';
      } catch (erro) {
        cnpjStatus.textContent = (erro as Error).message || 'Não conseguimos buscar o CNPJ agora. Pode seguir preenchendo.';
        cnpjStatus.removeAttribute('data-tom');
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const botao = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      const fd = new FormData(form);
      const dados: Record<string, string | string[]> = Object.fromEntries([...fd].map(([k, v]) => [k, String(v)]));
      dados.interesses = fd.getAll('interesses').map(String);
      botao.disabled = true;
      status.textContent = 'Enviando…';
      try {
        const r = await fetch(form.action, {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify(dados),
        });
        const resp = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(resp.erro || 'Não foi possível enviar agora.');
        form.hidden = true;
        ok.hidden = false;
        ok.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch (erro) {
        status.textContent = `${(erro as Error).message} Tente de novo ou escreva para o nosso e-mail.`;
        botao.disabled = false;
      }
    });

    // Botões da página que levam ao formulário já marcando um interesse
    document.addEventListener('click', (e) => {
      const link = (e.target as Element).closest<HTMLElement>('[data-interesse]');
      if (link) marcarInteresses(form, link.dataset.interesse!.split(','));
    });

    // Simulador e outros blocos que mandam um texto pronto para a mensagem
    document.addEventListener('dugood:mensagem', (e) => {
      const { texto, interesses: ids = [], regime } = (e as CustomEvent).detail;
      if (texto && !mensagem.value.includes(texto)) mensagem.value = mensagem.value ? `${mensagem.value}\n\n${texto}` : texto;
      marcarInteresses(form, ids);
      const select = form.querySelector<HTMLSelectElement>('select[name=regime]');
      if (select && regime && !select.value) select.value = regime;
    });
  }
</script>

<style>
  /* O formulário fica sobre o verde escuro: cores próprias, sem herdar as da seção */
  .form {
    color: var(--tinta);
    background: #fff;
    border: 1px solid var(--linha);
    border-radius: var(--raio);
    padding: clamp(24px, 4vw, 40px);
    box-shadow: var(--sombra);
  }
  .form h3 {
    color: var(--verde-escuro);
    font-size: 1.4rem;
    margin-bottom: 24px;
  }
  .form__grade {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    margin-bottom: 20px;
  }
  .form__largo {
    grid-column: 1 / -1;
  }
  .form__cnpj {
    margin-bottom: 16px;
  }
  .form__cnpj small {
    font-size: 0.82rem;
    font-weight: 400;
    color: var(--tinta-fraca);
  }
  .form__cnpj small[data-tom='ok'] {
    color: var(--verde-escuro);
    font-weight: 500;
  }
  .form__cnpj small[data-tom='erro'] {
    color: var(--tinta);
  }
  label {
    display: grid;
    gap: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--tinta);
  }
  input:not([type='checkbox']),
  select,
  textarea {
    width: 100%;
    font: 400 1rem/1.4 var(--texto);
    color: var(--tinta);
    background: var(--nevoa);
    border: 1px solid var(--cinza-1);
    border-radius: var(--raio-p);
    padding: 12px 14px;
    transition: border-color 0.2s, background 0.2s;
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    background: #fff;
    border-color: var(--verde);
    box-shadow: 0 0 0 3px var(--verde-claro);
  }
  textarea {
    resize: vertical;
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0 0 20px;
  }
  legend {
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 10px;
  }
  .form__opcoes {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .form__opcao {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 1px solid var(--linha);
    border-radius: 999px;
    font-weight: 400;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
  }
  .form__opcao:has(input:checked) {
    background: var(--verde-claro);
    border-color: var(--verde-claro-2);
    color: var(--verde-escuro);
  }
  input[type='checkbox'] {
    accent-color: var(--verde-escuro);
    width: 16px;
    height: 16px;
    margin: 0;
  }
  .form__aceite {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin: 20px 0 24px;
    font-weight: 400;
    color: var(--tinta-suave);
    font-size: 0.88rem;
  }
  .form__aceite input {
    margin-top: 3px;
    flex-shrink: 0;
  }
  .form .botao {
    background: var(--verde-escuro);
    color: #fff;
  }
  .form .botao:hover {
    background: #134513;
  }
  .form .botao:disabled {
    opacity: 0.6;
    cursor: wait;
  }
  .form__status {
    margin: 12px 0 0;
    font-size: 0.9rem;
    color: var(--tinta-suave);
  }
  .form__status:empty {
    display: none;
  }
  .form__alt {
    margin: 16px 0 0;
    font-size: 0.85rem;
    color: var(--tinta-fraca);
  }
  .form__isca {
    position: absolute;
    left: -9999px;
  }
  .form__ok {
    text-align: center;
  }
  .form__ok p {
    color: var(--tinta-suave);
    margin: 0;
  }
</style>
