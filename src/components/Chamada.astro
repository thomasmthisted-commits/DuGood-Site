---
// Chamada final sobre o fundo verde ondulado (páginas sem formulário): leva ao contato certo.
import { Image } from 'astro:assets';
import Onda from './Onda.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  titulo: string;
  texto: string;
  /** O primeiro é o botão principal */
  botoes: { texto: string; href: string }[];
  mascote: ImageMetadata;
}

const { titulo, texto, botoes, mascote } = Astro.props;
---

<section class="secao onda chamada" id="contato" aria-labelledby="contato-titulo">
  <Onda />
  <div class="conteiner chamada__grade">
    <div data-r>
      <span class="rotulo">Contato</span>
      <h2 id="contato-titulo">{titulo}</h2>
      <p class="lead">{texto}</p>
      <div class="botoes">
        {botoes.map((b, i) => <a class:list={['botao', { 'botao--claro': i > 0 }]} href={b.href}>{b.texto}</a>)}
      </div>
    </div>
    <Image class="mascote chamada__mascote" src={mascote} alt="" width={260} />
  </div>
</section>

<style>
  .chamada__grade {
    display: grid;
    gap: 32px;
    align-items: center;
  }
  .chamada .lead {
    margin-bottom: 28px;
  }
  .chamada__mascote {
    width: 180px;
    height: auto;
    justify-self: center;
  }
  @media (min-width: 900px) {
    .chamada__grade {
      grid-template-columns: 1fr auto;
    }
    .chamada__mascote {
      width: 240px;
    }
  }
</style>
