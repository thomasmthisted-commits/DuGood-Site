---
import { caminhos, type NomeIcone } from '../lib/icones';

interface Props {
  nome: NomeIcone;
  tamanho?: number;
}

const { nome, tamanho = 22 } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width={tamanho}
  height={tamanho}
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"><path d={caminhos[nome]}></path></svg
>
